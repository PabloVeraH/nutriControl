# Copiar a .env y completar. .env NO se versiona.

# Zona horaria
TZ=America/Santiago

# El modo (mock/hardware) lo fijan compose.mock.yaml y compose.hardware.yaml.

# Grafana
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-esta-clave

# InfluxDB (el bucket debe llamarse "hidro" para que coincidan los dashboards)
INFLUX_ORG=hidro
INFLUX_BUCKET=hidro
INFLUX_TOKEN=cambiar-por-un-token-largo-y-aleatorio
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=cambiar-esta-clave
INFLUX_RETENTION=8760h

# Telegram (crear el bot con @BotFather y obtener el chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Raspberry: solo en .env, nunca en git
DEPLOY_HOST=usuario@host
DEPLOY_PATH=~/nutriControl

# GIDs del host (getent group gpio / getent group i2c). Solo para la Pi.
GPIO_GID=997
I2C_GID=998
